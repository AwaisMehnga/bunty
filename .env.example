# OpenAI-compatible LLM (DeepSeek-style). Browser calls /api/llm; Vite forwards upstream.

# Upstream base URL (include /v1 when the vendor uses it)
LLM_BASE_URL=https://api.deepseek.com/v1

# Server-side key used when the UI API key field is empty
LLM_API_KEY=

# Back-compat alias for LLM_API_KEY
OPENAI_API_KEY=

# Client-bundled default model (UI can override)
VITE_LLM_MODEL=deepseek-chat

# Optional client hint for base URL when UI field is empty
# VITE_LLM_BASE_URL=https://api.deepseek.com/v1

# Back-compat alias for VITE_LLM_MODEL
# VITE_OPENAI_MODEL=gpt-4o-mini
